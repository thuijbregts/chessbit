            sourceSquare = (__tzcnt_u64((bitboard)));

            attacks = getRookAttacks(sourceSquare, occupancies[both]) & ~occupancies[side];
            nodes += __popcnt64(attacks);
        }

        bitboard = pieces[side][r] & pins[moveCount];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];

            attacks = getRookAttacks(sourceSquare, occupancies[both]) & ~occupancies[side] & pinMask;
            nodes += __popcnt64(attacks);
        }






        bitboard = pieces[side][q] & ~pins[moveCount];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));

            attacks = getQueenAttacks(sourceSquare, occupancies[both]) & ~occupancies[side];
            nodes += __popcnt64(attacks);
        }

        bitboard = pieces[side][q] & pins[moveCount];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];

            attacks = getQueenAttacks(sourceSquare, occupancies[both]) & ~occupancies[side] & pinMask;
            nodes += __popcnt64(attacks);
        }






        sourceSquare = king[side];

        attacks = getKingAttacks(sourceSquare) & ~occupancies[side];
        attacks = filterKingAttacks(occupancies[both], sourceSquare, attacks);
        nodes += __popcnt64(attacks);


        if ((castlingPermissions & CASTLING[side][CASTLE_K]) && castle(CASTLE_K)) {
            nodes++;
        }

        if ((castlingPermissions & CASTLING[side][CASTLE_Q]) && castle(CASTLE_Q)) {
            nodes++;
        }

        return nodes;
    }

    __forceinline static U64 filterKingAttacks(U64 occupancy, int kingSquare, U64 kingAttacks) {
        if (!kingAttacks) {
            return kingAttacks;
        }

        kingAttacks &= pawnAttackZones[!side][kingSquare][_pext_u64(pieces[!side][p], pawnZones[!side][kingSquare])];

        kingAttacks &= getKingAttacksInverted(king[!side]);


        (occupancy ^= SQUARE_BITS[kingSquare]);

        U64 bitboard;
        bitboard = pieces[!side][n] & knightAttackZones[kingSquare];
        for(;bitboard; bitboard = (__blsr_u64((bitboard)))) {
            kingAttacks &= getKnightAttacksInverted((__tzcnt_u64((bitboard))));
        }

        bitboard = (pieces[!side][b] | pieces[!side][q]) & bishopAttackZones[kingSquare];
        for(;bitboard; bitboard = (__blsr_u64((bitboard)))) {
            kingAttacks &= getBishopAttacksInverted((__tzcnt_u64((bitboard))), occupancy);
        }

        bitboard = (pieces[!side][r] | pieces[!side][q]) & rookAttackZones[kingSquare];
        for(;bitboard; bitboard = (__blsr_u64((bitboard)))) {
            kingAttacks &= getRookAttacksInverted((__tzcnt_u64((bitboard))), occupancy);
        }

        return kingAttacks;
    }

    __forceinline static bool castle(int castlingSide) {
        if (CASTLING_OCCUPIED_SQUARES[side][castlingSide] & occupancies[both]) {
            return false;
        }

        if (occupancies[!side] & CASTLING_FORBIDDEN_SQUARES[side][castlingSide]) {
            return false;
        }

        if ((occupancies[!side] ^ pieces[!side][n]) & CASTLING_FORBIDDEN_SQUARE_EXCEPT_KNIGHT[side][castlingSide]) {
            return false;
        }

        if ((occupancies[!side] ^ pieces[!side][r]) & CASTLING_FORBIDDEN_SQUARE_EXCEPT_ROOK[side][castlingSide]) {
            return false;
        }

        if (pieces[!side][n] & CASTLING_FORBIDDEN_KNIGHT_SQUARES[side][castlingSide]) {
            return false;
        }

        return castlingSquaresSafe(castlingSide);
    }

    __forceinline static bool castlingSquaresSafe(int castlingSide) {
        U64 bishopAttacks = (getBishopAttacks(CASTLING_ATTACK_SQUARES[side][castlingSide][0], occupancies[both]) & (pieces[!side][b] | pieces[!side][q]))
            | (getBishopAttacks(CASTLING_ATTACK_SQUARES[side][castlingSide][1], occupancies[both]) & (pieces[!side][b] | pieces[!side][q]));
        U64 rookAttacks = (getRookAttacks(CASTLING_ATTACK_SQUARES[side][castlingSide][0], occupancies[both]) & (pieces[!side][r] | pieces[!side][q]))
            | (getRookAttacks(CASTLING_ATTACK_SQUARES[side][castlingSide][1], occupancies[both]) & (pieces[!side][r] | pieces[!side][q]));

        return !(bishopAttacks | rookAttacks);
    }

    __forceinline static U64 passantPinMask(int pawnSquare) {
        int kingSquare = king[side];
        if (RANKS[pawnSquare] != RANKS[kingSquare]) {
            return FULL_BOARD;
        }

        int enemyPawn = enPassant + PAWN_PUSH[!side];
        U64 occupancy = occupancies[both];
        (occupancy ^= SQUARE_BITS[enemyPawn]);
        (occupancy ^= SQUARE_BITS[pawnSquare]);

        return PASSANT_PIN_RESULT[(__tzcnt_u64((getRookAttacks(kingSquare, occupancy) & potentialPinnerMasks[pawnSquare][kingSquare] & (pieces[!side][r] | pieces[!side][q]))))];
    }

    __forceinline static void findPins() {
        pins[moveCount] = 0;
        int kingSquare = king[side];

        iteratePieces(pieces[!side][b] & BISHOP_XRAYS[kingSquare], b, kingSquare);
        iteratePieces(pieces[!side][r] & ROOK_XRAYS[kingSquare], r, kingSquare);
        iteratePieces(pieces[!side][q] & QUEEN_XRAYS[kingSquare], q, kingSquare);
    }

    __forceinline static void iteratePieces(U64 pieces, int pieceType, int kingSquare) {
        int sliderSquare;
        U64 pinMask, pinnedPieces;

        for(;pieces; pieces = (__blsr_u64((pieces))))
        {
            sliderSquare = (__tzcnt_u64((pieces)));

            pinMask = pinMasks[pieceType][sliderSquare][kingSquare];
            pinnedPieces = pinMask & occupancies[both];

            if (__popcnt64(pinnedPieces) == 1 && (pinMask & occupancies[side])) {
                validAttacksMasks[moveCount][(__tzcnt_u64((pinnedPieces)))] = pinMask | SQUARE_BITS[sliderSquare];
                pins[moveCount] |= pinnedPieces;
            }
        }
    }

    __forceinline static void findPotentialDiscovers() {
        int kingSquare = king[!side];

        potentialDiscovers[moveCount] = (getBishopPins(kingSquare, occupancies[both]) & (pieces[side][b] | pieces[side][q]))
            | (getRookPins(kingSquare, occupancies[both]) & (pieces[side][r] | pieces[side][q]));
    }
}
