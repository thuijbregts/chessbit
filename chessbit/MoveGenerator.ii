                checkPieces[checkCount] = boardPieces[potentialPinnerSquare];
                checkCount++;
            }
        }


        pinnerMask = potentialPinnerMasks[ePawnSquare][enemyKingSquare] & occupancies[side] & BISHOP_XRAYS[ePawnSquare];

        if (pinnerMask) {
            int potentialPinnerSquare = ePawnSquare > enemyKingSquare ? (__tzcnt_u64((pinnerMask))) : (63 - __lzcnt64(pinnerMask));
            U64 pinMask = pinMasks[boardPieces[potentialPinnerSquare]][potentialPinnerSquare][enemyKingSquare];
            if (pinMask && !(pinMask & occupancies[both])) {
                checkSquares[checkCount] = potentialPinnerSquare;
                checkPieces[checkCount] = boardPieces[potentialPinnerSquare];
            }
        }
    }

    void init() {
        initPinMasks();
        initValidAttacksMasks();
        initPotentielPinnerMasks();
        initAttackZones();
        initChecks();
    }

    void initPinMasks() {
        int currentIndex, endIndex, bitShift;
        U64 pinMask;

        for (int piece = p; piece <= noPiece; piece++) {
            for (int i = 0; i < 64; i++) {
                for (int j = 0; j < 64; j++) {
                    pinMask = 0ULL;
                    bitShift = 0;

                    if (RANKS[i] == RANKS[j]) {
                        bitShift = (piece == r || piece == q) ? 1 : 0;
                    }

                    else if (FILES[i] == FILES[j]) {
                        bitShift = (piece == r || piece == q) ? 8 : 0;
                    }

                    else {
                        int x0 = RANKS[i];
                        int x1 = RANKS[j];
                        int y0 = FILES[i];
                        int y1 = FILES[j];

                        if (std::abs(x0 - x1) == std::abs(y0 - y1)) {
                            if ((i - j) % 9 == 0) {
                                bitShift = (piece == b || piece == q) ? 9 : 0;
                            }
                            else {
                                bitShift = (piece == b || piece == q) ? 7 : 0;
                            }
                        }
                    }

                    if (bitShift) {
                        if (i < j) {
                            currentIndex = i + bitShift;
                            endIndex = j - bitShift;
                        }
                        else {
                            currentIndex = j + bitShift;
                            endIndex = i - bitShift;
                        }
                        while (currentIndex <= endIndex) {
                            (pinMask |= SQUARE_BITS[currentIndex]);
                            currentIndex += bitShift;
                        }
                    }

                    pinMasks[piece][i][j] = pinMask;
                }
            }
            for (int i = 0; i < 64; i++) {
                pinMasks[piece][64][i] = 0ULL;
            }
        }
    }

    void initValidAttacksMasks() {
        for (int i = 0; i < 5949; i++) {
            for (int j = 0; j < 64; j++) {
                validAttacksMasks[i][j] = FULL_BOARD;
            }
        }
    }

    void initPotentielPinnerMasks() {
        int currentIndex, bitShift;
        U64 mask;

        for (int i = 0; i < 64; i++) {
            for (int j = 0; j < 64; j++) {
                mask = 0ULL;

                bitShift = 0;

                if (RANKS[i] == RANKS[j]) {
                    if (FILES[i] > 1 && FILES[i] < 8) {
                        bitShift = 1;
                    }
                }

                else if (FILES[i] == FILES[j]) {
                    if (RANKS[i] > 1 && RANKS[i] < 8) {
                        bitShift = 8;
                    }
                }

                else if (!EDGES[i]) {
                    int x0 = RANKS[i];
                    int x1 = RANKS[j];
                    int y0 = FILES[i];
                    int y1 = FILES[j];

                    if (std::abs(x0 - x1) == std::abs(y0 - y1)) {
                        if ((i - j) % 9 == 0) {
                            bitShift = 9;
                        }
                        else {
                            bitShift = 7;
                        }
                    }
                }

                if (bitShift) {
                    if (i < j) {
                        bitShift = -bitShift;
                    }
                    currentIndex = i + bitShift;

                    if (bitShift % 9 == 0 || bitShift % 7 == 0) {
                        while (!EDGES[currentIndex]) {
                            (mask |= SQUARE_BITS[currentIndex]);
                            currentIndex += bitShift;
                        }
                    }
                    else if (bitShift % 8 == 0) {
                        while (INNER_RANKS[currentIndex]) {
                            (mask |= SQUARE_BITS[currentIndex]);
                            currentIndex += bitShift;
                        }
                    }
                    else {
                        while (INNER_FILES[currentIndex]) {
                            (mask |= SQUARE_BITS[currentIndex]);
                            currentIndex += bitShift;
                        }
                    }
                    (mask |= SQUARE_BITS[currentIndex]);
                }

                potentialPinnerMasks[i][j] = mask;
            }
        }
    }

    void initAttackZones() {
        for (int square = 0; square < 64; square++) {
            initPawnZones(square);

            U64 attacks = getKingAttacks(square);
            for(;attacks; attacks = (__blsr_u64((attacks)))) {
                int attackSquare = (__tzcnt_u64((attacks)));

                knightAttackZones[square] |= getKnightAttacks(attackSquare);

                bishopAttackZones[square] |= BISHOP_XRAYS[attackSquare];

                rookAttackZones[square] |= ROOK_XRAYS[attackSquare];
            }
        }
    }

    void initPawnZones(int square) {
        U64 whiteZone = 0ULL, blackZone = 0ULL;
        for (int i = -2; i <= 2; i++) {
            int currentSquare = square + (i * 8);
            if (currentSquare < 0 || currentSquare > 63) {
                continue;
            }
            if (RANKS[currentSquare] <= RANKS[square] && RANKS[currentSquare] < 8) (whiteZone |= SQUARE_BITS[currentSquare]);
            if (RANKS[currentSquare] >= RANKS[square] && RANKS[currentSquare] > 1) (blackZone |= SQUARE_BITS[currentSquare]);
            if (currentSquare - 2 >= 0 && FILES[currentSquare - 2] < 7) {
                if (RANKS[currentSquare] <= RANKS[square] && RANKS[currentSquare] < 8) (whiteZone |= SQUARE_BITS[currentSquare - 2]);
                if (RANKS[currentSquare] >= RANKS[square] && RANKS[currentSquare] > 1) (blackZone |= SQUARE_BITS[currentSquare - 2]);
            }
            if (currentSquare - 1 >= 0 && FILES[square - 1] < 8) {
                if (i != 1 && RANKS[currentSquare] <= RANKS[square] && RANKS[currentSquare] < 8) (whiteZone |= SQUARE_BITS[currentSquare - 1]);
                if (i != -1 && RANKS[currentSquare] >= RANKS[square] && RANKS[currentSquare] > 1) (blackZone |= SQUARE_BITS[currentSquare - 1]);
            }
            if (currentSquare + 1 < 64 && FILES[currentSquare + 1] > 1) {
                if (i != 1 && RANKS[currentSquare] <= RANKS[square] && RANKS[currentSquare] < 8) (whiteZone |= SQUARE_BITS[currentSquare + 1]);
                if (i != -1 && RANKS[currentSquare] >= RANKS[square] && RANKS[currentSquare] > 1) (blackZone |= SQUARE_BITS[currentSquare + 1]);
            }
            if (currentSquare + 2 < 64 && FILES[currentSquare + 2] > 2) {
                if (RANKS[currentSquare] <= RANKS[square] && RANKS[currentSquare] < 8) (whiteZone |= SQUARE_BITS[currentSquare + 2]);
                if (RANKS[currentSquare] >= RANKS[square] && RANKS[currentSquare] > 1) (blackZone |= SQUARE_BITS[currentSquare + 2]);
            }
        }
        pawnZones[white][square] = whiteZone;
        pawnZones[black][square] = blackZone;

        std::vector<int> bitPositionsWhite;
        std::vector<int> bitPositionsBlack;
        for (int i = 0; i < 64; ++i) {
            if (whiteZone & (1ULL << i)) {
                bitPositionsWhite.push_back(i);
            }
            if (blackZone & (1ULL << i)) {
                bitPositionsBlack.push_back(i);
            }
        }

        int combinationsWhite = pow(2, __popcnt64(whiteZone));
        int combinationsBlack = pow(2, __popcnt64(blackZone));
        for (int i = 0; i < combinationsWhite; i++) {
            U64 attacks = whiteZone;

            for (int pos : bitPositionsWhite) {
                attacks &= ~(1ULL << pos);
            }

            for (int j = 0; j < __popcnt64(whiteZone); ++j) {
                if (i & (1 << j)) {
                    attacks |= (1ULL << bitPositionsWhite[j]);
                }
            }

            U64 attacksLoop = attacks;
            for(;attacksLoop; attacksLoop = (__blsr_u64((attacksLoop)))) {
                int attackSquare = (__tzcnt_u64((attacksLoop)));
                pawnAttackZones[white][square][i] |= PAWN_CAPTURES[white][attackSquare];
            }
            pawnAttackZones[white][square][i] = ~pawnAttackZones[white][square][i];
        }
        for (int i = 0; i < combinationsBlack; i++) {
            U64 attacks = blackZone;

            for (int pos : bitPositionsBlack) {
                attacks &= ~(1ULL << pos);
            }

            for (int j = 0; j < __popcnt64(blackZone); ++j) {
                if (i & (1 << j)) {
                    attacks |= (1ULL << bitPositionsBlack[j]);
                }
            }

            U64 attacksLoop = attacks;
            for(;attacksLoop; attacksLoop = (__blsr_u64((attacksLoop)))) {
                int attackSquare = (__tzcnt_u64((attacksLoop)));
                pawnAttackZones[black][square][i] |= PAWN_CAPTURES[black][attackSquare];
            }
            pawnAttackZones[black][square][i] = ~pawnAttackZones[black][square][i];
        }
    }

    void initChecks() {
        for (int i = 0; i < 64; i++) {
            for (int j = 0; j < 64; j++) {
                if (PAWN_CAPTURES[white][i] & SQUARE_BITS[j]) pawnChecks[white][i][j] = i;
                else pawnChecks[white][i][j] = noSquare;

                if (PAWN_CAPTURES[black][i] & SQUARE_BITS[j]) pawnChecks[black][i][j] = i;
                else pawnChecks[black][i][j] = noSquare;

                if (KNIGHT_ATTACKS[i] & SQUARE_BITS[j]) knightChecks[i][j] = i;
                else knightChecks[i][j] = noSquare;
            }
        }
    }

    void generateMoves(MoveArray& moves) {
        int sourceSquare, targetSquare;
        U64 bitboard, attacks, pinMask;

        findPotentialDiscovers();

        if (checkSquares[0] != noSquare) {






            int kingSquare = king[side];


            attacks = getKingAttacks(kingSquare) & ~occupancies[side] & ~pinMasks[boardPieces[checkSquares[0]]][checkSquares[0]][kingSquare] & ~pinMasks[boardPieces[checkSquares[1]]][checkSquares[1]][kingSquare];
            attacks = filterKingAttacks(occupancies[both], kingSquare, attacks);
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.king(kingSquare, targetSquare, boardPieces[targetSquare]);
            }


            if (checkSquares[1] == noSquare) {

                (pieces[!side][checkPieces[0]] ^= SQUARE_BITS[checkSquares[0]]);
                findPins();
                (pieces[!side][checkPieces[0]] |= SQUARE_BITS[checkSquares[0]]);

                U64 checkBit = SQUARE_BITS[checkSquares[0]];


                if (CAPTURE_ONLY[checkPieces[0]]) {





                    targetSquare = checkSquares[0];

                    bitboard = pieces[side][p];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));

                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = PAWN_CAPTURES[side][sourceSquare] & checkBit & pinMask;
                        if (attacks)
                        {
                            if (PROMO_RANK[side][sourceSquare])
                            {
                                moves.promotion(sourceSquare, targetSquare, boardPieces[targetSquare]);
                            }
                            else {
                                moves.pawn(sourceSquare, targetSquare, boardPieces[targetSquare]);
                            }
                        }
                        else {

                            attacks = PAWN_CAPTURES[side][sourceSquare] & SQUARE_BITS[enPassant] & pinMask;
                            if (attacks && checkSquares[0] == enPassant + PAWN_PUSH[!side]) {
                                moves.enPassant(sourceSquare, enPassant);
                            }
                        }
                    }






                    bitboard = pieces[side][n];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getKnightAttacks(sourceSquare) & checkBit & pinMask;
                        if (attacks) {
                            moves.knight(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][b];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getBishopAttacks(sourceSquare, occupancies[both]) & checkBit & pinMask;
                        if (attacks) {
                            moves.bishop(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][r];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getRookAttacks(sourceSquare, occupancies[both]) & checkBit & pinMask;
                        if (attacks) {
                            moves.rook(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][q];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getQueenAttacks(sourceSquare, occupancies[both]) & checkBit & pinMask;
                        if (attacks) {
                            moves.queen(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }

                }
                else {


                    U64 validSquares = (checkBit | pinMasks[boardPieces[checkSquares[0]]][checkSquares[0]][kingSquare]);






                    bitboard = pieces[side][p] & PROMO_RANKS[side];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getPawnAttacks(sourceSquare, occupancies[both], occupancies[!side], side) & pinMask & validSquares;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.promotion(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }

                    bitboard = pieces[side][p] & ~PROMO_RANKS[side];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getPawnAttacks(sourceSquare, occupancies[both], occupancies[!side], side) & pinMask & validSquares;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.pawn(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][n];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getKnightAttacks(sourceSquare) & validSquares & pinMask;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.knight(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][b];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getBishopAttacks(sourceSquare, occupancies[both]) & validSquares & pinMask;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.bishop(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][r];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getRookAttacks(sourceSquare, occupancies[both]) & validSquares & pinMask;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.rook(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }






                    bitboard = pieces[side][q];
                    for(;bitboard; bitboard = (__blsr_u64((bitboard))))
                    {
                        sourceSquare = (__tzcnt_u64((bitboard)));
                        pinMask = validAttacksMasks[moveCount][sourceSquare];
                        validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

                        attacks = getQueenAttacks(sourceSquare, occupancies[both]) & validSquares & pinMask;
                        for(;attacks; attacks = (__blsr_u64((attacks)))) {
                            targetSquare = (__tzcnt_u64((attacks)));

                            moves.queen(sourceSquare, targetSquare, boardPieces[targetSquare]);
                        }
                    }
                }
            }

            return;
        }

        findPins();






        bitboard = PAWN_CAPTURES[!side][enPassant] & pieces[side][p];
        for(;bitboard; bitboard = (__blsr_u64((bitboard)))) {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];

            if (SQUARE_BITS[enPassant] & pinMask & passantPinMask(sourceSquare)) {
                moves.enPassant(sourceSquare, enPassant);
            }
        }

        bitboard = pieces[side][p] & PROMO_RANKS[side];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getPawnAttacks(sourceSquare, occupancies[both], occupancies[!side], side) & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks)))) {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.promotion(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }

        bitboard = pieces[side][p] & ~PROMO_RANKS[side];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getPawnAttacks(sourceSquare, occupancies[both], occupancies[!side], side) & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks)))) {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.pawn(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }






        bitboard = pieces[side][n];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getKnightAttacks(sourceSquare) & ~occupancies[side] & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.knight(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }






        bitboard = pieces[side][b];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getBishopAttacks(sourceSquare, occupancies[both]) & ~occupancies[side] & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.bishop(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }






        bitboard = pieces[side][r];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getRookAttacks(sourceSquare, occupancies[both]) & ~occupancies[side] & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.rook(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }






        bitboard = pieces[side][q];
        for(;bitboard; bitboard = (__blsr_u64((bitboard))))
        {
            sourceSquare = (__tzcnt_u64((bitboard)));
            pinMask = validAttacksMasks[moveCount][sourceSquare];
            validAttacksMasks[moveCount][sourceSquare] = FULL_BOARD;

            attacks = getQueenAttacks(sourceSquare, occupancies[both]) & ~occupancies[side] & pinMask;
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                moves.queen(sourceSquare, targetSquare, boardPieces[targetSquare]);
            }
        }






        sourceSquare = king[side];

        attacks = getKingAttacks(sourceSquare) & ~occupancies[side];
        attacks = filterKingAttacks(occupancies[both], sourceSquare, attacks);
        for(;attacks; attacks = (__blsr_u64((attacks))))
        {
            targetSquare = (__tzcnt_u64((attacks)));

            moves.king(sourceSquare, targetSquare, boardPieces[targetSquare]);
        }


        if ((castlingPermissions & CASTLING[side][CASTLE_K]) && castle(CASTLE_K)) {
            moves.castling(CASTLING_KING_TARGET_SQUARE[side][CASTLE_K]);
        }

        if ((castlingPermissions & CASTLING[side][CASTLE_Q]) && castle(CASTLE_Q)) {
            moves.castling(CASTLING_KING_TARGET_SQUARE[side][CASTLE_Q]);
        }
    }

    U64 generateMovesPerft(int depth) {
        if (depth == 1) {
            return generateMovesCount();
        }

        findPotentialDiscovers();

        int sourceSquare, targetSquare;
        U64 bitboard, attacks, pinMask;

        U64 nodes = 0ULL;

        if (checkSquares[0] != noSquare) {






            int kingSquare = king[side];


            attacks = getKingAttacks(kingSquare) & ~occupancies[side] & ~pinMasks[boardPieces[checkSquares[0]]][checkSquares[0]][kingSquare] & ~pinMasks[boardPieces[checkSquares[1]]][checkSquares[1]][kingSquare];
            attacks = filterKingAttacks(occupancies[both], kingSquare, attacks);
            for(;attacks; attacks = (__blsr_u64((attacks))))
            {
                targetSquare = (__tzcnt_u64((attacks)));

                MoveInfo move = KING_MOVES[boardPieces[targetSquare]][kingSquare][targetSquare];
                makeKing(move);
                nodes += generateMovesPerft(depth - 1);
                unmakeKing(move);
            }


            if (checkSquares[1] == noSquare) {

                (pieces[!side][checkPieces[0]] ^= SQUARE_BITS[checkSquares[0]]);
                findPins();
                (pieces[!side][checkPieces[0]] |= SQUARE_BITS[checkSquares[0]]);

                U64 checkBit = SQUARE_BITS[checkSquares[0]];


                if (CAPTURE_ONLY[checkPieces[0]]) {





