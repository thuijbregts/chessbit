                template <class _CharT, class _Traits>
    basic_ostream<_CharT, _Traits>& operator<<(basic_ostream<_CharT, _Traits>& _Os, const local_info& _Val) {
        switch (_Val.result) {
        case local_info::unique:
            return _Os << ::std:: format(_Os.getloc(),
                       (_Choose_literal<_CharT>("result: unique, first: ({})", L"result: unique, first: ({})")),
                       _Val.first);
        case local_info::nonexistent:
            return _Os << ::std:: format(_Os.getloc(),
                       (_Choose_literal<_CharT>("result: nonexistent, first: ({}), second: ({})", L"result: nonexistent, first: ({}), second: ({})")),
                       _Val.first, _Val.second);
        case local_info::ambiguous:
            return _Os << ::std:: format(_Os.getloc(),
                       (_Choose_literal<_CharT>("result: ambiguous, first: ({}), second: ({})", L"result: ambiguous, first: ({}), second: ({})")),
                       _Val.first, _Val.second);
        default:
            return _Os << ::std:: format(_Os.getloc(),
                       (_Choose_literal<_CharT>("result: {}, first: ({}), second: ({})", L"result: {}, first: ({}), second: ({})")),
                       _Val.result, _Val.first, _Val.second);
        }
    }

