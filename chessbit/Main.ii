    _FwdIt1 _First1, _FwdIt1 _Last1, _FwdIt2 _First2, _FwdIt2 _Last2, _Pr _Pred) {

                                                   ;
                                                                                         ;
    if constexpr (_Is_ranges_bidi_iter_v<_FwdIt1> && _Is_ranges_bidi_iter_v<_FwdIt2>) {
        do {
            --_Last1;
            --_Last2;
        } while (_Pred(*_Last1, *_Last2));

