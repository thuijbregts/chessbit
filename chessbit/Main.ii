template <class _CharT, _Parse_spec_callbacks<_CharT> _Callbacks_type>
[[nodiscard]] constexpr const _CharT* _Parse_format_specs(
    const _CharT* _First, const _CharT* _Last, _Callbacks_type&& _Callbacks) {
