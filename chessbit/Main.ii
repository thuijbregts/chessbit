        }
    };

    struct PawnAttack
    {
        const U64* AttackPtr;
        const U64 Mask;

        constexpr PawnAttack(int offset, U64 mask, bool side) : AttackPtr(PAWN_ATTACKS[side] + offset), Mask(mask) {

        }

        __forceinline constexpr U64 operator[](const U64 blocker) const
        {
            if (std::is_constant_evaluated()) {
                return AttackPtr[_pext_u64_emulated(blocker, Mask)];
            }
            else {
                return AttackPtr[_pext_u64(blocker, Mask)];
            }
        }
    };

