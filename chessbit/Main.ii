using namespace std::chrono;

void benchmark() {
    high_resolution_clock::time_point start, end;
    duration<int, std::milli> total, best;

    for (int depth = 6; depth <= 6; depth++) {
        for (int i = 0; i < 25; i++) {
            start = high_resolution_clock::now();
            auto volatile result = movegen::generateMovesPerft6();
            end = high_resolution_clock::now();

            total = duration_cast<duration<int, std::milli>>(end - start);
            printf("Time:\t\t%d\t%llu\n", total.count(), result);
            if (i == 0) {
                best = total;
            }
            else if (total.count() < best.count()) {
                best = total;
            }
        }

        printf("Best time:\t\t%d\n", best.count());
    }
}

