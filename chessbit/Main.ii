            _Leap_sec_info.assign(::std:: cbegin(_Known_leap_seconds), ::std:: cend(_Known_leap_seconds));

            for (size_t _Idx = 0; _Idx < _Reg_post_2018_ls_size; ++_Idx) {


                const auto& _Ls = _Reg_ls_data[_Idx];
                const auto _Date =
