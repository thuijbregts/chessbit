    void initRookPins(int square);

    void setFen(const char* fen);

    __forceinline static constexpr U64 getPawnAttacks(int square, U64 occupancyBoth, U64 occupancyEnemy, bool side) {
        U64 occupancy = occupancyEnemy | (occupancyBoth & PAWN_FRONT_MASKS[side][square]);
        return PAWN_ATTACKS_LOOKUP[side][square][occupancy];
    }

    __forceinline static constexpr U64 getBishopAttacks(int square, U64 occupancy) {
        return BISHOP_ATTACKS_LOOKUP[square][occupancy];
    }

    __forceinline static constexpr U64 getRookAttacks(int square, U64 occupancy) {
        return ROOK_ATTACKS_LOOKUP[square][occupancy];
    }

    __forceinline static constexpr U64 getQueenAttacks(int square, U64 occupancy) {
        return getBishopAttacks(square, occupancy) | getRookAttacks(square, occupancy);
    }

    __forceinline static constexpr U64 getKingAttacks(int square) {
        return KING_ATTACKS[square];
    }

    __forceinline static constexpr U64 getKnightAttacks(int square) {
        return KNIGHT_ATTACKS[square];
    }

    __forceinline static constexpr U64 getKingAttacksInverted(int square) {
        return ~KING_ATTACKS[square];
    }

    __forceinline static constexpr U64 getKnightAttacksInverted(int square) {
        return ~KNIGHT_ATTACKS[square];
    }

    __forceinline static constexpr U64 getBishopAttacksInverted(int square, U64 occupancy) {
        return ~BISHOP_ATTACKS_LOOKUP[square][occupancy];
    }

    __forceinline static constexpr U64 getRookAttacksInverted(int square, U64 occupancy) {
        return ~ROOK_ATTACKS_LOOKUP[square][occupancy];
    }

    static inline U64 getBishopPins(int square, U64 occupancy) {
        return bishopPins[BISHOP_PIN_OFFSETS[square] + _pext_u64(occupancy, BISHOP_XRAYS[square])];
    }

    static inline U64 getRookPins(int square, U64 occupancy) {
        return rookPins[ROOK_PIN_OFFSETS[square] + _pext_u64(occupancy, ROOK_XRAYS[square])];
    }
