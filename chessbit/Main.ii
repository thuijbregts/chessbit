                template <class _CharT, class _Traits>
    basic_ostream<_CharT, _Traits>& operator<<(basic_ostream<_CharT, _Traits>& _Os, const weekday_indexed& _Val) {
        const auto _Idx = _Val.index();
        return _Os << (_Idx >= 1 && _Idx <= 5
                           ? ::std:: format(_Os.getloc(), (_Choose_literal<_CharT>("{:L}[{}]", L"{:L}[{}]")), _Val.weekday(), _Idx)
                           : ::std:: format(_Os.getloc(), (_Choose_literal<_CharT>("{:L}[{} is not a valid index]", L"{:L}[{} is not a valid index]")),
                               _Val.weekday(), _Idx));
